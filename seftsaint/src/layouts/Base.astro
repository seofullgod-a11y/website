---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { ui } from '../data/ui';

interface Props {
  /** Page title — the site name is appended automatically (except on home). */
  title?: string;
  description?: string;
  /** Absolute or root-relative URL of a 1200×630 image. */
  ogImage?: string;
  type?: 'website' | 'article';
  /** Extra JSON-LD object for this page. */
  jsonLd?: Record<string, unknown>;
}

const { title, description = site.meta.description, ogImage = site.meta.ogImage, type = 'website', jsonLd } =
  Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : site.meta.title;
const base = site.url || (Astro.site ? Astro.site.origin : '');
const abs = (p: string) => (base && p.startsWith('/') ? new URL(p, base).href : p);
const canonical = base ? new URL(Astro.url.pathname, base).href : undefined;
const handle = site.handle.startsWith('@') ? site.handle : `@${site.handle}`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0d0e0f" />
    <meta name="color-scheme" content="dark" />
    <meta name="author" content={site.name} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Social preview -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs(ogImage)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={handle} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(ogImage)} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Enables reveal animations only when JS runs, so content is never hidden without it. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    left: var(--gutter);
    top: 12px;
    z-index: 200;
    padding: 0.6rem 0.9rem;
    background: var(--ink);
    color: var(--bg);
    font-size: var(--text-sm);
    border-radius: var(--radius);
    transform: translateY(-160%);
    transition: transform var(--t) var(--ease);
  }
  .skip-link:focus-visible {
    transform: none;
  }
  main {
    display: block;
    outline: none;
  }
</style>
