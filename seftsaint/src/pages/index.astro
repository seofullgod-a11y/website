---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeaturedWorld from '../components/FeaturedWorld.astro';
import ProjectList from '../components/ProjectList.astro';
import ProofBand from '../components/ProofBand.astro';
import Story from '../components/Story.astro';
import About from '../components/About.astro';
import Partner from '../components/Partner.astro';
import DevlogLatest from '../components/DevlogLatest.astro';
import { site } from '../data/site';
import { effects } from '../data/effects';
import { getProjects } from '../lib/content';

const projects = getProjects();
const featured = projects.find((p) => p.featured) ?? projects[0];
const others = projects.filter((p) => p !== featured);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  ...(site.url ? { url: site.url } : {}),
  sameAs: [site.xUrl],
};
---

<Base jsonLd={jsonLd} intro={effects.intro}>
  <!-- 1. The world -->
  <Hero project={featured} />

  <!-- 2. It's real: the numbers -->
  <ProofBand no="01" />

  <!-- 3. The way in -->
  {featured && <FeaturedWorld project={featured} no="02" />}
  {
    others.length > 0 && (
      <div class="container more-work">
        <ProjectList projects={others} startIndex={2} />
      </div>
    )
  }

  <!-- 4. What changed lately — the devlog (posted from /studio) -->
  <DevlogLatest no="03" />

  <!-- 5. Who -->
  <About no="04" />

  <!-- 6. How it happened — ends on an open chapter -->
  <Story no="05" />

  <!-- 7. The ask -->
  {site.partner.enabled && <Partner no="06" />}
</Base>

<style>
  .more-work {
    padding-bottom: 4rem;
  }
</style>
