---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeaturedWorld from '../components/FeaturedWorld.astro';
import ProofBand from '../components/ProofBand.astro';
import Story from '../components/Story.astro';
import About from '../components/About.astro';
import Partner from '../components/Partner.astro';
import DevlogLatest from '../components/DevlogLatest.astro';
import { site } from '../data/site';
import { effects } from '../data/effects';
import { getProjects } from '../lib/content';

const projects = getProjects();
const featured = projects.find((p) => p.featured) ?? projects[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  ...(site.url ? { url: site.url } : {}),
  sameAs: [site.xUrl],
};
---

<Base jsonLd={jsonLd} intro={effects.intro}>
  <!-- 1. The world -->
  <Hero project={featured} />

  <!-- 2. It's real: the numbers -->
  <ProofBand no="01" />

  <!-- 3. The way in -->
  {featured && <FeaturedWorld project={featured} no="02" />}
  {/* Earlier projects are told in "The last world" (Story) further down */}

  <!-- 4. What changed lately — the devlog (posted from /studio) -->
  <DevlogLatest no="03" />

  <!-- 5. Who -->
  <About no="04" />

  <!-- 6. The last world (Forest Concept) — ends on the open chapter: Ashira1600 -->
  <Story no="05" />

  <!-- 7. The ask -->
  {site.partner.enabled && <Partner no="06" />}
</Base>

