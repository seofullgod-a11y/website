---
/**
 * Closing — the last thing on every page: the journey continues, and how to reach me.
 * Content: src/data/site.ts → closing.
 */
import { site } from '../data/site';
import { ui } from '../data/ui';
import { promote, partnerMailto } from '../lib/partner';
import Arrow from './Arrow.astro';

const c = site.closing;
const [line1, line2] = c.line;
const mailto = promote('footer') ? partnerMailto() : site.email ? `mailto:${site.email}` : '';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <div class="closing" data-reveal>
      <p class="eyebrow eyebrow--rule" data-decode-area data-decode-reveal>
        <span data-decode>{c.kicker}</span>
      </p>
      <p class="display closing__line">
        <span>{line1}</span>
        {line2 && <em>{line2}</em>}
      </p>
      <div class="closing__side">
        <p class="closing__text">{c.text}</p>
        <div class="closing__cta">
          {
            mailto && (
              <a class="btn-line" href={mailto} data-decode-area>
                <span data-decode>{c.ctaWrite}</span>
                <Arrow dir="ne" />
              </a>
            )
          }
          <a class="link-line" href={site.xUrl} target="_blank" rel="noopener me" data-decode-area>
            <span data-decode>{c.ctaFollow}</span>
            <Arrow dir="ne" />
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </div>
      </div>
    </div>

    <div class="footer__bar">
      <p class="footer__brand">
        <span class="footer__name">{site.name}</span>
        <span class="footer__note">{ui.footer.note}</span>
      </p>
      <ul class="footer__links" role="list">
        {
          site.email && (
            <li>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </li>
          )
        }
        <li>
          <a href={site.xUrl} target="_blank" rel="noopener me" data-decode-area>
            <span data-decode>{site.handle}</span>
            <span class="visually-hidden">on X (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a href="#top" data-decode-area>
            <span data-decode>{ui.footer.top}</span> <Arrow dir="n" />
          </a>
        </li>
        <li class="footer__year">© {year}</li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(3rem, 2rem + 4vw, 6rem);
    border-top: 1px solid var(--line);
  }
  /* Right after the partner band: no second line, no extra gap */
  :global(main:has(> .partner:last-child)) + .footer {
    margin-top: 0;
    border-top: 0;
  }
  .footer__inner {
    max-width: var(--max);
    margin-inline: auto;
    padding: clamp(4rem, 3rem + 4vw, 7rem) var(--gutter) max(2rem, env(safe-area-inset-bottom));
  }

  .closing {
    display: grid;
    gap: 1.75rem var(--gap);
  }
  @media (min-width: 1024px) {
    .closing {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }
    .closing .eyebrow {
      grid-column: 1 / -1;
    }
    .closing__line {
      grid-column: 1 / span 8;
    }
    .closing__side {
      grid-column: 9 / -1;
    }
  }
  .closing__line {
    font-size: clamp(2.25rem, 1.3rem + 3vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .closing__line span,
  .closing__line em {
    display: block;
  }
  .closing__line em {
    color: var(--ink-2);
    padding-left: 0.3em;
  }
  .closing__text {
    color: var(--ink-2);
    max-width: 30ch;
  }
  .closing__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
  }

  .footer__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: clamp(4rem, 3rem + 3vw, 6rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .footer__brand {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
  }
  .footer__name {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 440;
    letter-spacing: -0.02em;
  }
  .footer__note {
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.75rem;
    list-style: none;
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .footer__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 36px;
    transition: color var(--t-fast) var(--ease);
  }
  .footer__links a:hover {
    color: var(--ink);
  }
  .footer__links li:first-child {
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 0.8125rem;
  }
</style>
