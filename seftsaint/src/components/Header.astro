---
import { site } from '../data/site';
import { ui } from '../data/ui';
import { effects } from '../data/effects';
import { promote, partnerHref } from '../lib/partner';
import Arrow from './Arrow.astro';

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const talk = promote('headerPill');
const nav = [
  { key: 'work', href: '/#work', label: ui.nav.work },
  { key: 'notes', href: '/#notes', label: ui.nav.notes },
  ...(site.partner.enabled ? [{ key: 'partner', href: '/#partner', label: ui.nav.partner }] : []),
  { key: 'about', href: '/#about', label: ui.nav.about },
];
---

<header class="header" data-header>
  <div class="header__inner">
    <div class="header__brand">
      <a class="wordmark" href="/" aria-label={`${site.name} — ${ui.nav.home}`} aria-current={isHome ? 'page' : undefined}>
        {site.name}
      </a>
      <p class="header__tags" aria-hidden="true">
        {
          site.disciplines.map((d, i) => (
            <>
              {i > 0 && <span class="header__slash">/</span>}
              <span>{d}</span>
            </>
          ))
        }
      </p>
    </div>

    <nav class="nav" aria-label="Main">
      <ul role="list">
        {
          nav.map((item) => (
            <li>
              <a class="nav__link" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="nav__link" href={site.xUrl} target="_blank" rel="noopener me">
            {ui.nav.x}
            <Arrow dir="ne" />
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </nav>

    {
      talk && (
        <a class="btn-line btn-line--sm header__talk" href={partnerHref}>
          {ui.nav.talk}
          <Arrow dir="ne" />
        </a>
      )
    }

    <button
      class="header__menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      data-menu-toggle
      data-label-open={ui.nav.menu}
      data-label-close={ui.nav.closeMenu}
    >
      <span class="header__menu-icon" aria-hidden="true"><span></span><span></span></span>
      <span data-menu-label>{ui.nav.menu}</span>
    </button>
  </div>

  <div class="menu" id="site-menu" data-menu hidden>
    <ul class="menu__list" role="list">
      {
        nav.map((item, i) => (
          <li>
            <a class="menu__link" href={item.href} data-menu-link>
              <span class="menu__index">{String(i + 1).padStart(2, '0')}</span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu__foot">
      {
        talk && (
          <a class="btn-solid" href={partnerHref} data-menu-link>
            {ui.nav.talk}
            <Arrow dir="ne" />
          </a>
        )
      }
      <a class="link-line" href={site.xUrl} target="_blank" rel="noopener me">
        {site.handle}
        <Arrow dir="ne" />
        <span class="visually-hidden">on X (opens in a new tab)</span>
      </a>
    </div>
  </div>

  {effects.scrollProgress && <span class="header__progress" data-progress aria-hidden="true" />}
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: var(--header-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--t-slow) var(--ease),
      border-color var(--t-slow) var(--ease);
  }
  .header:global(.is-scrolled),
  :global(html.menu-open) .header {
    background-color: rgb(11 12 12 / 0.84);
    border-bottom-color: var(--line);
    -webkit-backdrop-filter: saturate(140%) blur(16px);
    backdrop-filter: saturate(140%) blur(16px);
  }
  .header__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--ink);
    opacity: 0;
    transform: scaleX(var(--progress, 0));
    transform-origin: 0 50%;
    transition: opacity var(--t) var(--ease);
    pointer-events: none;
  }
  .header:global(.is-scrolled) .header__progress:global(.is-on) {
    opacity: 0.35;
  }

  .header__inner {
    height: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .header__brand {
    display: flex;
    align-items: baseline;
    gap: 2.25rem;
    min-width: 0;
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 1.6875rem;
    font-weight: 360;
    letter-spacing: -0.025em;
    line-height: 1;
    padding-block: 0.4rem;
    white-space: nowrap;
  }
  .header__tags {
    display: none;
    gap: 0.9rem;
    font-size: 0.625rem;
    font-weight: 450;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .header__slash {
    color: var(--ink-faint);
  }
  @media (min-width: 1180px) {
    .header__tags {
      display: flex;
    }
  }

  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 0.2rem + 1.2vw, 1.75rem);
    list-style: none;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding-inline: 0.35rem;
    font-size: 0.6875rem;
    font-weight: 450;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: color var(--t-fast) var(--ease);
  }
  .nav__link:hover {
    color: var(--ink);
  }
  .header__talk {
    margin-left: 0.75rem;
  }

  /* Menu button — small screens only */
  .header__menu-btn {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding-inline: 0.25rem;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .header__menu-icon {
    display: grid;
    gap: 5px;
    width: 18px;
  }
  .header__menu-icon span {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform var(--t) var(--ease);
  }
  .header__menu-btn[aria-expanded='true'] .header__menu-icon span:first-child {
    transform: translateY(3px) rotate(45deg);
  }
  .header__menu-btn[aria-expanded='true'] .header__menu-icon span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  @media (max-width: 860px) {
    .nav {
      display: none;
    }
    .header__menu-btn {
      display: inline-flex;
    }
    .header__talk {
      margin-left: auto;
    }
  }
  @media (max-width: 420px) {
    .header__talk {
      display: none;
    }
    .header__menu-btn {
      margin-left: auto;
    }
    .wordmark {
      font-size: 1.5rem;
    }
  }

  /* Full-screen menu (small screens) */
  .menu {
    position: fixed;
    top: var(--header-h);
    left: 0;
    right: 0;
    height: calc(100dvh - var(--header-h));
    padding: 2rem var(--gutter) max(2rem, env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--bg);
    overflow-y: auto;
  }
  .menu[hidden] {
    display: none;
  }
  .menu__list {
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 3vw, 2.75rem);
    font-weight: 320;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .menu__index {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    color: var(--ink-3);
  }
  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 2rem;
  }
  @media (min-width: 861px) {
    .menu {
      display: none !important;
    }
  }
</style>
