---
/**
 * Then & now — drag (or hover, with a mouse) to compare two frames.
 * Left of the divider: the earlier frame. Right: the later one.
 * Keyboard: focus the slider and use ← → (Home / End jump to the edges).
 */
import { Picture } from 'astro:assets';
import type { Update } from '../data/types';
import { ui } from '../data/ui';
import { resolveImage } from '../lib/media';
import { formatDate } from '../lib/format';

interface Props {
  before: Update;
  after: Update;
  sizes?: string;
}
const { before, after, sizes = '(min-width: 1440px) 1000px, (min-width: 1000px) 72vw, 100vw' } = Astro.props;
const a = resolveImage(before.media?.image);
const b = resolveImage(after.media?.image);
const name = (u: Update) => `${formatDate(u.date)} · ${u.label ?? u.title}`;
---

{
  a && b && (
    <figure class="cmp" data-compare style="--pos:50%">
      <div class="cmp__frame" data-compare-frame>
        <Picture
          src={a}
          alt={before.media?.alt ?? ''}
          formats={['avif', 'webp']}
          widths={[480, 768, 1024, 1280].filter((w) => w <= a.width)}
          sizes={sizes}
          loading="lazy"
          class="cmp__img"
          pictureAttributes={{ class: 'cmp__pic' }}
        />
        <div class="cmp__after">
          <Picture
            src={b}
            alt={after.media?.alt ?? ''}
            formats={['avif', 'webp']}
            widths={[480, 768, 1024, 1280].filter((w) => w <= b.width)}
            sizes={sizes}
            loading="lazy"
            class="cmp__img"
            pictureAttributes={{ class: 'cmp__pic' }}
          />
        </div>

        <span class="cmp__tag cmp__tag--before mono" aria-hidden="true">{name(before)}</span>
        <span class="cmp__tag cmp__tag--after mono" aria-hidden="true">{name(after)}</span>

        <div class="cmp__line" aria-hidden="true">
          <span class="cmp__knob">
            <svg viewBox="0 0 20 12">
              <path d="M6 1 1 6l5 5M14 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.4" />
            </svg>
          </span>
        </div>

        <input
          class="cmp__range"
          type="range"
          min="0"
          max="100"
          step="5"
          value="50"
          aria-label={`${ui.fx.compareLabel}: ${name(before)} / ${name(after)}`}
          data-compare-range
        />
      </div>
      <figcaption class="cmp__caption">
        <span class="mono">{ui.fx.compareHint}</span>
        <span>
          {before.label ?? before.title} → {after.label ?? after.title}
        </span>
      </figcaption>
    </figure>
  )
}

<style>
  .cmp {
    margin: 0;
  }
  .cmp__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--frame);
    border-radius: var(--radius);
    overflow: clip;
    isolation: isolate;
    cursor: ew-resize;
    touch-action: pan-y; /* vertical scroll stays native on touch */
    user-select: none;
    -webkit-user-select: none;
  }
  .cmp__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 6;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(236 233 226 / 0.06);
    pointer-events: none;
  }
  .cmp__pic,
  .cmp__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cmp__img {
    object-fit: cover;
    pointer-events: none;
    -webkit-user-drag: none;
  }
  .cmp__after {
    position: absolute;
    inset: 0;
    z-index: 1;
    clip-path: inset(0 0 0 var(--pos));
  }

  .cmp__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    z-index: 4;
    width: 1px;
    background: rgb(236 233 226 / 0.85);
    box-shadow: 0 0 12px rgb(0 0 0 / 0.5);
    transform: translateX(-0.5px);
    pointer-events: none;
  }
  .cmp__knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--ink);
    background: rgb(13 14 15 / 0.62);
    box-shadow: inset 0 0 0 1px rgb(236 233 226 / 0.35);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transform: translate(-50%, -50%);
    transition:
      transform var(--t) var(--ease),
      box-shadow var(--t) var(--ease);
  }
  .cmp__knob svg {
    width: 18px;
    height: 12px;
  }
  .cmp__frame:hover .cmp__knob,
  .cmp[data-dragging] .cmp__knob {
    transform: translate(-50%, -50%) scale(1.06);
  }
  .cmp__range:focus-visible ~ .cmp__line .cmp__knob,
  .cmp__frame:has(.cmp__range:focus-visible) .cmp__knob {
    box-shadow:
      inset 0 0 0 1px rgb(236 233 226 / 0.35),
      0 0 0 2px var(--accent);
  }

  .cmp__tag {
    position: absolute;
    top: 12px;
    z-index: 5;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    color: var(--ink);
    background: rgb(13 14 15 / 0.6);
    box-shadow: inset 0 0 0 1px rgb(236 233 226 / 0.14);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    white-space: nowrap;
    transition: opacity var(--t) var(--ease);
    pointer-events: none;
  }
  .cmp__tag--before {
    left: 12px;
  }
  .cmp__tag--after {
    right: 12px;
  }
  .cmp[data-edge='left'] .cmp__tag--before,
  .cmp[data-edge='right'] .cmp__tag--after {
    opacity: 0;
  }
  @media (max-width: 560px) {
    .cmp__tag {
      font-size: 10px;
      top: 8px;
    }
    .cmp__tag--before {
      left: 8px;
    }
    .cmp__tag--after {
      right: 8px;
    }
  }

  /* The real control: invisible, but focusable and operable by keyboard / AT */
  .cmp__range {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
    z-index: 7;
  }

  .cmp__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 0.8rem;
    font-size: 0.875rem;
    color: var(--ink-2);
  }
  .cmp__caption .mono {
    color: var(--ink-3);
  }
</style>
