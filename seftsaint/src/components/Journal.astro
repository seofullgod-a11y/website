---
import { now } from '../data/updates';
import { site } from '../data/site';
import { ui } from '../data/ui';
import { getUpdates, getProjects } from '../lib/content';
import { formatDate } from '../lib/format';

interface Props {
  /** How many entries to show on the home page. */
  limit?: number;
}
const { limit = 6 } = Astro.props;

const all = getUpdates();
const entries = all.slice(0, limit);
const projectTitle = new Map(getProjects().map((p) => [p.slug, p.title]));
---

<div class="journal">
  <aside class="now" aria-labelledby="now-title" data-reveal>
    <div class="now__inner">
      <p class="now__head mono">
        <span id="now-title" class="now__title"><span class="now__dot" aria-hidden="true"></span>{ui.sections.now}</span>
        <span class="now__updated">
          {ui.journal.updated} <time datetime={now.updated}>{formatDate(now.updated)}</time>
        </span>
      </p>
      <dl class="now__list">
        {
          now.items.map((item) => (
            <div class="now__item">
              <dt class="mono">{item.label}</dt>
              <dd>
                {item.href ? (
                  <a class="link link--quiet" href={item.href}>
                    {item.text}
                  </a>
                ) : (
                  item.text
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </aside>

  <div class="entries">
    <p class="entries__intro">{ui.journal.intro}</p>
    <ol class="entries__list" role="list">
      {
        entries.map((u, i) => (
          <li class="entry" data-reveal style={`--reveal-delay:${Math.min(i, 4) * 40}ms`}>
            <article aria-labelledby={`entry-${u.id}`}>
              <time class="entry__date mono" datetime={u.date}>
                {formatDate(u.date)}
              </time>
              <div class="entry__body">
                <h3 id={`entry-${u.id}`} class="entry__title">
                  {u.title}
                </h3>
                {u.body.map((para) => (
                  <p class="entry__text">{para}</p>
                ))}
                <p class="entry__meta">
                  {u.project && projectTitle.has(u.project) && (
                    <a class="link link--quiet" href={`/work/${u.project}/#${u.id}`}>
                      <span class="mono entry__meta-label">{ui.journal.project}</span>
                      {projectTitle.get(u.project)}
                      <span class="arrow arrow--e" aria-hidden="true">
                        →
                      </span>
                    </a>
                  )}
                  {u.sourceUrl && (
                    <a class="link link--quiet" href={u.sourceUrl} target="_blank" rel="noopener">
                      {ui.journal.viewPost}
                      <span class="arrow arrow--ne" aria-hidden="true">
                        ↗
                      </span>
                      <span class="visually-hidden">on X (opens in a new tab)</span>
                    </a>
                  )}
                </p>
                {u.tools && u.tools.length > 0 && <p class="entry__tools mono">{u.tools.join(' · ')}</p>}
              </div>
            </article>
          </li>
        ))
      }
    </ol>
    {
      all.length > limit && (
        <a class="link link--quiet entries__more" href={site.xUrl} target="_blank" rel="noopener">
          {ui.journal.older} <span class="arrow arrow--ne" aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</div>

<style>
  .journal {
    display: grid;
    gap: 3rem var(--gap);
  }
  @media (min-width: 1000px) {
    .journal {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }
    .now {
      grid-column: 1 / span 4;
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
    .entries {
      grid-column: 6 / -1;
    }
  }

  /* ── Now ── */
  .now__inner {
    padding: 1.5rem;
    background: var(--bg-raised);
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .now__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    color: var(--ink-3);
    margin-bottom: 1.25rem;
  }
  .now__title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
  }
  .now__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .now__list {
    display: grid;
    gap: 1.1rem;
  }
  .now__item dt {
    color: var(--ink-3);
    margin-bottom: 0.25rem;
  }
  .now__item dd {
    margin: 0;
    color: var(--ink);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .now__item dd :global(.link) {
    color: var(--ink);
    display: inline;
    background-size: 100% 1px;
    background-position: 0 100%;
  }
  .now__item dd :global(.link:hover) {
    background-size: 0% 1px;
    background-position: 100% 100%;
  }

  /* ── Entries ── */
  .entries__intro {
    color: var(--ink-2);
    font-size: var(--text-md);
    max-width: 46ch;
    margin-bottom: 2rem;
  }
  .entries__list {
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .entry article {
    display: grid;
    gap: 0.6rem var(--gap);
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 640px) {
    .entry article {
      grid-template-columns: 8.5rem minmax(0, 1fr);
    }
  }
  .entry__date {
    color: var(--ink-3);
    padding-top: 0.3rem;
  }
  .entry__title {
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin-bottom: 0.6rem;
  }
  .entry__text {
    color: var(--ink-2);
    max-width: 62ch;
  }
  .entry__text + .entry__text {
    margin-top: 0.6rem;
  }
  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1rem;
    font-size: 0.875rem;
  }
  .entry__meta :global(.link) {
    min-height: 32px;
  }
  .entry__meta-label {
    color: var(--ink-3);
    margin-right: 0.25rem;
  }
  .entry__tools {
    margin-top: 0.4rem;
    color: var(--ink-3);
    text-transform: none;
  }
  .entries__more {
    margin-top: 1.5rem;
    font-size: 0.875rem;
  }
</style>
