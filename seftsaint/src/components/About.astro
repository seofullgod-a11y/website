---
import { site } from '../data/site';
import { ui } from '../data/ui';
---

<div class="about">
  <div class="about__text" data-reveal>
    <p class="about__lead">{site.about.lead}</p>
    {site.about.body.map((p) => <p class="about__body">{p}</p>)}
  </div>
  <div class="about__connect" data-reveal style="--reveal-delay:60ms">
    <p class="mono about__label">{ui.sections.connect}</p>
    <p class="about__connect-text">{site.connect.text}</p>
    <a class="about__handle" href={site.xUrl} target="_blank" rel="noopener me">
      <span>{site.handle}</span>
      <span class="arrow arrow--ne" aria-hidden="true">↗</span>
      <span class="visually-hidden">on X (opens in a new tab)</span>
    </a>
    {
      site.email && (
        <a class="about__email link link--quiet" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      )
    }
  </div>
</div>

<style>
  .about {
    display: grid;
    gap: 3rem var(--gap);
  }
  @media (min-width: 1000px) {
    .about {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }
    .about__text {
      grid-column: 1 / span 7;
    }
    .about__connect {
      grid-column: 9 / -1;
    }
  }
  .about__lead {
    font-size: clamp(1.5rem, 1rem + 1.9vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 400;
    max-width: 24ch;
    text-wrap: balance;
  }
  .about__body {
    margin-top: 1.25rem;
    color: var(--ink-2);
    font-size: var(--text-md);
    max-width: 54ch;
  }
  .about__body + .about__body {
    margin-top: 0.75rem;
  }

  .about__connect {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .about__label {
    color: var(--ink-3);
  }
  .about__connect-text {
    margin-top: 0.75rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .about__handle {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 0.15rem;
    transition: background-size var(--t-slow) var(--ease);
  }
  .about__handle:hover {
    background-size: 0% 1px;
    background-position: 100% 100%;
  }
  .about__email {
    display: flex;
    width: fit-content;
    margin-top: 1rem;
    font-size: 0.9375rem;
  }
  .about__handle .arrow {
    font-size: 0.7em;
    color: var(--ink-2);
  }
</style>
