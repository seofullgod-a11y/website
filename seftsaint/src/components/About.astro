---
import { site } from '../data/site';
import { ui } from '../data/ui';
import { getProjects, getUpdates } from '../lib/content';
import { formatDate } from '../lib/format';
import { partnerHref } from '../lib/partner';

// The story so far — straight from updates.ts (oldest first) and projects.ts.
const story = [...getUpdates()].reverse();
const projects = getProjects();
const uniq = (xs: readonly string[]) => [...new Set(xs)];
const tools = uniq(projects.flatMap((p) => p.tools ?? []));
const ai = uniq(projects.flatMap((p) => p.ai ?? []));
---

<div class="about">
  <div class="about__text" data-reveal>
    <p class="about__lead">{site.about.lead}</p>
    {site.about.body.map((p) => <p class="about__body">{p}</p>)}
  </div>
  <div class="about__connect" data-reveal style="--reveal-delay:60ms">
    <p class="mono about__label">{ui.sections.connect}</p>
    <p class="about__connect-text">{site.connect.text}</p>
    <a class="about__handle" href={site.xUrl} target="_blank" rel="noopener me">
      <span>{site.handle}</span>
      <span class="arrow arrow--ne" aria-hidden="true">↗</span>
      <span class="visually-hidden">on X (opens in a new tab)</span>
    </a>
    {
      site.email && (
        <a class="about__email link link--quiet" href={`mailto:${site.email}`}>
          {site.email}
        </a>
      )
    }
  </div>

  {
    story.length > 0 && (
      <div class="story" data-reveal>
        <p class="mono about__label">{ui.about.soFar}</p>
        <ol class="story__list" role="list">
          {story.map((u, i) => (
            <li class="story__item" style={`--i:${i}`}>
              <time class="story__date mono" datetime={u.date}>
                {formatDate(u.date)}
              </time>
              <a class="story__title" href={u.project ? `/work/${u.project}/#${u.id}` : (u.sourceUrl ?? '#')}>
                {u.title}
              </a>
            </li>
          ))}
          {site.partner.enabled && (
            <li class="story__item story__item--now" style={`--i:${story.length}`}>
              <span class="story__date mono">{ui.about.now}</span>
              <a class="story__title" href={partnerHref}>
                {site.partner.heroLink}
                <span class="arrow arrow--e" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          )}
        </ol>
      </div>
    )
  }

  {
    (tools.length > 0 || ai.length > 0) && (
      <div class="toolkit" data-reveal style="--reveal-delay:60ms">
        <p class="mono about__label">{ui.about.toolkit}</p>
        <dl class="toolkit__list">
          {tools.length > 0 && (
            <div class="toolkit__row">
              <dt class="mono">{ui.about.tools}</dt>
              <dd>{tools.join(' · ')}</dd>
            </div>
          )}
          {ai.length > 0 && (
            <div class="toolkit__row">
              <dt class="mono">{ui.about.ai}</dt>
              <dd>{ai.join(' · ')}</dd>
            </div>
          )}
        </dl>
      </div>
    )
  }
</div>

<style>
  .about {
    display: grid;
    gap: 3rem var(--gap);
  }
  @media (min-width: 1000px) {
    .about {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }
    .about__text {
      grid-column: 1 / span 7;
    }
    .about__connect {
      grid-column: 9 / -1;
    }
    .story {
      grid-column: 1 / span 7;
    }
    .toolkit {
      grid-column: 9 / -1;
      align-self: start;
    }
  }

  /* So far — a short timeline that draws itself in */
  .story {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .story__list {
    position: relative;
    list-style: none;
    margin-top: 1.25rem;
    padding-left: 1.25rem;
  }
  .story__list::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.55rem;
    bottom: 0.55rem;
    width: 1px;
    background: linear-gradient(var(--line-2), var(--accent));
    transform-origin: 50% 0;
    transition: transform 900ms var(--ease) 120ms;
  }
  :global(.js) .story:not(:global(.is-in)) .story__list::before {
    transform: scaleY(0);
  }
  .story__item {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: 0.45rem;
    transition:
      opacity 500ms var(--ease) calc(200ms + var(--i) * 90ms),
      transform 500ms var(--ease) calc(200ms + var(--i) * 90ms);
  }
  :global(.js) .story:not(:global(.is-in)) .story__item {
    opacity: 0;
    transform: translateX(-8px);
  }
  .story__item::before {
    content: '';
    position: absolute;
    left: calc(-1.25rem);
    top: 50%;
    width: 5px;
    height: 5px;
    margin-top: -2.5px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--ink-3);
  }
  .story__item--now::before {
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }
  .story__date {
    color: var(--ink-3);
  }
  .story__title {
    font-size: 1rem;
    color: var(--ink);
    transition: color var(--t-fast) var(--ease);
  }
  .story__title:hover {
    color: var(--accent);
  }
  .story__item--now .story__title {
    color: var(--accent);
  }
  .story__title .arrow {
    margin-left: 0.35em;
  }
  @media (max-width: 480px) {
    .story__item {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
    .story__item::before {
      top: 0.9rem;
    }
  }

  /* Toolkit */
  .toolkit {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .toolkit__list {
    margin-top: 1.25rem;
    display: grid;
    gap: 1rem;
  }
  .toolkit__row {
    display: grid;
    gap: 0.3rem;
  }
  .toolkit__row dt {
    color: var(--ink-3);
  }
  .toolkit__row dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .story__list::before,
    .story__item {
      transition: none;
    }
  }
  .about__lead {
    font-size: clamp(1.5rem, 1rem + 1.9vw, 2.5rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    font-weight: 400;
    max-width: 24ch;
    text-wrap: balance;
  }
  .about__body {
    margin-top: 1.25rem;
    color: var(--ink-2);
    font-size: var(--text-md);
    max-width: 54ch;
  }
  .about__body + .about__body {
    margin-top: 0.75rem;
  }

  .about__connect {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .about__label {
    color: var(--ink-3);
  }
  .about__connect-text {
    margin-top: 0.75rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .about__handle {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 0.15rem;
    transition: background-size var(--t-slow) var(--ease);
  }
  .about__handle:hover {
    background-size: 0% 1px;
    background-position: 100% 100%;
  }
  .about__email {
    display: flex;
    width: fit-content;
    margin-top: 1rem;
    font-size: 0.9375rem;
  }
  .about__handle .arrow {
    font-size: 0.7em;
    color: var(--ink-2);
  }
</style>
