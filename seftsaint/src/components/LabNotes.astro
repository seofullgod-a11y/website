---
/**
 * Lab notes — the development journal as a quiet index, not a blog.
 * Content: updates.ts (entries + the "Now" note) · site.ts → notes (headline, intro).
 */
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { ui } from '../data/ui';
import { now } from '../data/updates';
import { getUpdates } from '../lib/content';
import { resolveImage, resolveVideo } from '../lib/media';
import { formatDate, formatDateNumeric } from '../lib/format';
import Arrow from './Arrow.astro';

interface Props {
  limit?: number;
}
const { limit = 6 } = Astro.props;
const n = site.notes;
const [h1, h2] = n.headline;

const all = getUpdates(); // newest first
const entries = await Promise.all(
  all.slice(0, limit).map(async (u, i) => {
    const video = resolveVideo(u.media?.video);
    const img = resolveImage(u.media?.image);
    const poster = video && img ? (await getImage({ src: img, width: 1280, format: 'webp', quality: 80 })).src : '';
    const excerpt = u.excerpt ?? (u.body[0]?.split(/(?<=\.)\s/)[0] ?? '');
    return { u, video, poster, excerpt, no: String(all.length - i).padStart(2, '0') };
  }),
);
const nowItems = now.items.filter((x) => !x.href?.includes('#partner')).slice(0, 2);
---

<section id="notes" class="notes" aria-labelledby="notes-title" data-nudge-trigger>
  <div class="notes__grid">
    <header class="notes__head" data-reveal>
      <p class="eyebrow">{n.kicker}</p>
      <h2 id="notes-title" class="display notes__title">
        <span>{h1}</span>
        {h2 && <em>{h2}</em>}
      </h2>
      <p class="notes__intro">{n.intro}</p>

      <div class="notes__now">
        <p class="notes__now-head">
          <span class="status-dot" aria-hidden="true"></span>
          <span class="eyebrow">{ui.notes.now}</span>
          <time class="mono notes__now-date" datetime={now.updated}>{formatDate(now.updated)}</time>
        </p>
        <dl class="notes__now-list">
          {
            nowItems.map((it) => (
              <div>
                <dt class="eyebrow">{it.label}</dt>
                <dd>{it.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </header>

    <ol class="notes__list" role="list">
      {
        entries.map(({ u, video, poster, excerpt, no }, i) => (
          <li class="note" data-reveal style={`--reveal-delay:${Math.min(i, 4) * 60}ms`}>
            <span class="note__no mono" aria-hidden="true">
              N°{no}
            </span>
            <time class="note__date mono" datetime={u.date}>
              {formatDateNumeric(u.date)}
            </time>
            <div class="note__main">
              <h3 class="note__title">
                <a href={u.project ? `/work/${u.project}/#${u.id}` : (u.sourceUrl ?? '#')}>{u.title}</a>
              </h3>
              {excerpt && <p class="note__excerpt">{excerpt}</p>}
              {u.tools && u.tools.length > 0 && <p class="note__tools">{u.tools.slice(0, 3).join(' · ')}</p>}
            </div>
            <div class="note__links">
              {video && (
                <button
                  type="button"
                  class="note__link"
                  data-play-src={video}
                  data-play-poster={poster}
                  data-play-title={u.title}
                  data-play-meta={`${formatDate(u.date)} · ${u.label ?? u.title}`}
                  data-play-post={u.sourceUrl ?? u.media?.sourceUrl}
                  aria-haspopup="dialog"
                >
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M5.5 3.5v9l7-4.5z" fill="currentColor" />
                  </svg>
                  {ui.notes.watch}
                  <span class="visually-hidden">: {u.title}</span>
                </button>
              )}
              {u.sourceUrl && (
                <a class="note__link" href={u.sourceUrl} target="_blank" rel="noopener">
                  {ui.notes.onX}
                  <Arrow dir="ne" />
                  <span class="visually-hidden">: {u.title} (opens in a new tab)</span>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .notes {
    max-width: var(--max);
    margin-inline: auto;
    padding: clamp(5rem, 3rem + 6vw, 9rem) var(--gutter) 0;
  }
  .notes__grid {
    display: grid;
    gap: 3rem var(--gap);
  }
  @media (min-width: 1024px) {
    .notes__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }
    .notes__head {
      grid-column: 1 / span 4;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
    .notes__list {
      grid-column: 6 / -1;
    }
  }

  .notes__title {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 1.6rem + 2.8vw, 4.25rem);
  }
  .notes__title span,
  .notes__title em {
    display: block;
  }
  .notes__intro {
    margin-top: 1.25rem;
    max-width: 34ch;
    color: var(--ink-2);
  }

  .notes__now {
    margin-top: 2.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .notes__now-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .notes__now-head .eyebrow {
    color: var(--ink);
  }
  .notes__now-date {
    margin-left: auto;
    color: var(--ink-3);
  }
  .notes__now-list {
    display: grid;
    gap: 0.9rem;
    margin-top: 1rem;
  }
  .notes__now-list dt {
    font-size: 0.625rem;
  }
  .notes__now-list dd {
    margin: 0.15rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink);
  }

  /* The index */
  .notes__list {
    list-style: none;
    border-top: 1px solid var(--line-2);
  }
  .note {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 6.5rem minmax(0, 1fr) auto;
    gap: 0.5rem 1.25rem;
    align-items: baseline;
    padding-block: 1.6rem;
    border-bottom: 1px solid var(--line);
  }
  .note::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -1px;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 600ms var(--ease);
  }
  .note:hover::before {
    transform: scaleX(1);
  }
  .note__no,
  .note__date {
    color: var(--ink-3);
  }
  .note__no {
    color: var(--ink-faint);
  }
  .note__title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem);
    font-weight: 340;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }
  .note__title a {
    transition: color var(--t) var(--ease);
  }
  .note__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .note:hover .note__title a {
    color: #fff;
  }
  .note__excerpt {
    margin-top: 0.5rem;
    max-width: 52ch;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .note__tools {
    margin-top: 0.6rem;
    font-size: 0.625rem;
    font-weight: 450;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .note__links {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.25rem 1.25rem;
  }
  .note__link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: color var(--t-fast) var(--ease);
  }
  .note__link:hover {
    color: var(--ink);
  }
  .note__link svg {
    width: 9px;
    height: 9px;
  }

  @media (max-width: 760px) {
    .note {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.35rem 1rem;
    }
    .note__no {
      grid-row: 1;
    }
    .note__date {
      grid-row: 1;
      justify-self: end;
    }
    .note__main,
    .note__links {
      grid-column: 1 / -1;
    }
    .note__links {
      margin-top: 0.25rem;
    }
  }
</style>
