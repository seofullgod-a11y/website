---
/**
 * Partners & investors — confident, calm, specific.
 * Content: src/data/site.ts → partner. Numbers must be real (see proofNote).
 */
import { site } from '../data/site';
import { ui } from '../data/ui';
import { partnerMailto, promote } from '../lib/partner';
import Arrow from './Arrow.astro';

const p = site.partner;
const [line1, line2] = p.headline;
const mailto = partnerMailto();
const countUp = promote('countUp');
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="partner" class="partner" aria-labelledby="partner-title">
  <div class="partner__inner">
    <p class="eyebrow eyebrow--rule" data-reveal>{p.kicker}</p>

    <div class="partner__top">
      <h2 id="partner-title" class="display partner__title" data-reveal>
        <span>{line1}</span>
        {line2 && <em>{line2}</em>}
      </h2>

      <div class="partner__pitch" data-reveal style="--reveal-delay:80ms">
        <p class="partner__lead">{p.lead}</p>
        {p.body.map((t) => <p class="partner__body">{t}</p>)}

        <div class="partner__cta">
          {
            mailto && (
              <a class="btn-solid" href={mailto}>
                {p.ctaTalk}
                <Arrow dir="ne" />
              </a>
            )
          }
          <a class="link-line" href={site.xUrl} target="_blank" rel="noopener me">
            {p.ctaX}
            <Arrow dir="ne" />
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </div>
        {
          site.email && (
            <p class="partner__email">
              <span class="partner__address">{site.email}</span>
              <button
                type="button"
                class="copy"
                data-copy={site.email}
                data-copied-label={p.ctaCopied}
                data-announce={ui.partner.copiedAnnounce}
                hidden
              >
                <span data-copy-label>{p.ctaCopy}</span>
              </button>
              <span class="visually-hidden" role="status" data-copy-status />
            </p>
          )
        }
      </div>
    </div>

    <div class="partner__bottom">
      <div class="partner__proof" data-reveal>
        <dl class="proof">
          {
            p.proof.map((x) => (
              <div class="proof__item">
                <dt class="proof__label">{x.label}</dt>
                <dd class="proof__value display">
                  <span aria-hidden="true" data-count={countUp ? x.value : undefined}>
                    {x.value}
                  </span>
                  <span class="visually-hidden">{x.value}</span>
                </dd>
              </div>
            ))
          }
        </dl>
        {p.proofNote && <p class="proof__note">{p.proofNote}</p>}
      </div>

      <div class="partner__unlocks" data-reveal style="--reveal-delay:80ms">
        <p class="eyebrow">{p.unlocksTitle}</p>
        <ol class="unlocks" role="list">
          {
            p.unlocks.map((u, i) => (
              <li class="unlock">
                <span class="unlock__no mono">{pad(i + 1)}</span>
                <span class="unlock__title">{u.title}</span>
                <span class="unlock__text">{u.text}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .partner {
    margin-top: clamp(5rem, 3rem + 6vw, 9rem);
    background: var(--bg-raised);
    border-block: 1px solid var(--line);
  }
  .partner__inner {
    max-width: var(--max);
    margin-inline: auto;
    padding: clamp(4rem, 3rem + 4vw, 7rem) var(--gutter);
  }

  .partner__top {
    display: grid;
    gap: 2.5rem var(--gap);
    margin-top: clamp(1.75rem, 1.2rem + 1.5vw, 2.5rem);
  }
  @media (min-width: 1024px) {
    .partner__top {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: end;
    }
    .partner__title {
      grid-column: 1 / span 7;
    }
    .partner__pitch {
      grid-column: 8 / -1;
      padding-left: clamp(1.5rem, 0.5rem + 2vw, 3rem);
      border-left: 1px solid var(--line-2);
    }
  }
  .partner__title {
    font-size: clamp(3.25rem, 1.4rem + 6.2vw, 8rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
  }
  .partner__title span,
  .partner__title em {
    display: block;
  }
  .partner__title em {
    padding-left: 0.3em;
  }
  .partner__lead {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.1rem + 0.8vw, 1.75rem);
    font-weight: 340;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }
  .partner__body {
    margin-top: 1rem;
    color: var(--ink-2);
    max-width: 46ch;
  }
  .partner__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 2rem;
  }
  .partner__email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    margin-top: 1.25rem;
    font-size: 0.875rem;
  }
  .partner__address {
    color: var(--ink-2);
    user-select: all;
  }
  .copy {
    min-height: 32px;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-3);
    transition: color var(--t-fast) var(--ease);
  }
  .copy[hidden] {
    display: none;
  }
  .copy:hover {
    color: var(--ink);
  }
  .copy[data-state='copied'] {
    color: var(--accent);
  }

  .partner__bottom {
    display: grid;
    gap: 3rem var(--gap);
    margin-top: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    padding-top: clamp(2rem, 1.5rem + 1.5vw, 3rem);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 1024px) {
    .partner__bottom {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .partner__proof {
      grid-column: 1 / span 7;
    }
    .partner__unlocks {
      grid-column: 8 / -1;
      padding-left: clamp(1.5rem, 0.5rem + 2vw, 3rem);
    }
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }
  .proof__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.6rem;
  }
  .proof__value {
    margin: 0;
    font-size: clamp(2.25rem, 1.3rem + 3vw, 4.25rem);
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .proof__label {
    color: var(--ink-2);
    font-size: 0.8125rem;
    line-height: 1.45;
    max-width: 18ch;
  }
  .proof__note {
    margin-top: 1.5rem;
    color: var(--ink-3);
    font-size: 0.75rem;
  }

  .unlocks {
    list-style: none;
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .unlock {
    display: grid;
    grid-template-columns: 2.5rem 6.5rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    align-items: baseline;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .unlock__no {
    color: var(--ink-3);
  }
  .unlock__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 360;
    letter-spacing: -0.01em;
  }
  .unlock__text {
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  @media (max-width: 560px) {
    .unlock {
      grid-template-columns: 2.25rem minmax(0, 1fr);
    }
    .unlock__text {
      grid-column: 2;
    }
    .proof {
      gap: 0.75rem;
    }
    .proof__label {
      font-size: 0.75rem;
    }
  }
</style>
