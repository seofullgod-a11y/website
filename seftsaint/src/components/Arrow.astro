---
/** Thin arrow used in CTAs. dir: ne ↗ · e → · s ↓ · w ← · n ↑ */
interface Props {
  dir?: 'ne' | 'e' | 's' | 'w' | 'n';
  class?: string;
}
const { dir = 'ne', class: className } = Astro.props;
const paths = {
  ne: 'M4.5 11.5 11.5 4.5M5.5 4.5h6v6',
  e: 'M2.5 8h11M9.5 4l4 4-4 4',
  s: 'M8 2.5v11M4 9.5l4 4 4-4',
  w: 'M13.5 8h-11M6.5 4l-4 4 4 4',
  n: 'M8 13.5v-11M4 6.5l4-4 4 4',
};
---

<svg class:list={['arrow-icon', `arrow-icon--${dir}`, className]} viewBox="0 0 16 16" aria-hidden="true" focusable="false">
  <path d={paths[dir]} fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>

<style>
  .arrow-icon {
    width: 11px;
    height: 11px;
    flex: none;
    transition: transform var(--t) var(--ease);
  }
  :global(a:hover) > .arrow-icon--ne,
  :global(a:focus-visible) > .arrow-icon--ne,
  :global(button:hover) > .arrow-icon--ne {
    transform: translate(2px, -2px);
  }
  :global(a:hover) > .arrow-icon--e,
  :global(a:focus-visible) > .arrow-icon--e,
  :global(button:hover) > .arrow-icon--e {
    transform: translateX(3px);
  }
  :global(a:hover) > .arrow-icon--s,
  :global(a:focus-visible) > .arrow-icon--s {
    transform: translateY(3px);
  }
  :global(a:hover) > .arrow-icon--w,
  :global(a:focus-visible) > .arrow-icon--w,
  :global(button:hover) > .arrow-icon--w {
    transform: translateX(-3px);
  }
</style>
