---
/**
 * The one-page version of the site (site.ts → mode: 'contact').
 * Pure black: the game's name, one line, a form that emails you, and how to reach you.
 * The form posts to /api/contact (server/contact.mjs); without JavaScript it still works
 * (the server answers with /#sent or /#not-sent, shown below with :target).
 */
import { site } from '../data/site';
import Arrow from './Arrow.astro';

const c = site.contact;
const f = c.form;
const email = site.email;
const year = new Date().getFullYear();
const handle = site.handle.startsWith('@') ? site.handle : `@${site.handle}`;
const fields = { name: 'cf-name', email: 'cf-email', message: 'cf-message', link: 'cf-link' };
const mailto = email ? `mailto:${email}?subject=${encodeURIComponent(f.emailSubject)}` : '';
---

<div class="cp">
  <div class="cp-top container">
    <a class="cp-wordmark" href="/" aria-label={site.name} data-decode-area>
      <span data-decode>{site.name}</span>
    </a>
    <p class="cp-top__status eyebrow">
      <span class="status-dot" aria-hidden="true"></span>
      <span>{c.status}</span>
    </p>
  </div>

  <div class="cp-main container">
    <section class="cp-intro" aria-labelledby="cp-title">
      <p class="cp-kicker eyebrow cp-rise" style="--d:80ms" data-decode-area>
        <span data-decode data-decode-reveal>{c.kicker}</span>
      </p>
      <h1 class="cp-title display cp-rise" id="cp-title" style="--d:180ms">
        {c.title}<span class="cp-title__mark">{c.mark}</span>
      </h1>
      <p class="cp-lead cp-rise" style="--d:320ms">{c.lead}</p>

      <div class="cp-direct cp-rise" style="--d:460ms">
        <p class="cp-label eyebrow">{c.direct.kicker}</p>
        <dl class="cp-direct__list">
          {
            email && (
              <div class="cp-direct__row">
                <dt class="eyebrow">{c.direct.email}</dt>
                <dd>
                  <a class="cp-direct__link" href={mailto}>
                    {email}
                  </a>
                  <button
                    class="cp-copy eyebrow"
                    type="button"
                    data-copy={email}
                    data-copied={c.direct.copied}
                    hidden
                  >
                    {c.direct.copy}
                  </button>
                </dd>
              </div>
            )
          }
          <div class="cp-direct__row">
            <dt class="eyebrow">{c.direct.x}</dt>
            <dd>
              <a class="cp-direct__link" href={site.xUrl} target="_blank" rel="noopener me">
                {handle}
                <Arrow dir="ne" />
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="cp-panel cp-rise" style="--d:380ms" id="write" aria-labelledby="cp-form-title">
      <!-- Without JavaScript the server sends people back here with one of these. -->
      <div class="cp-target" id="sent" role="status">
        <p class="cp-sent__title display">{f.sentTitle}</p>
        <p class="cp-sent__text">{f.sentText.replace(/,?\s*\{name\}/, '').replace('{email}', email)}</p>
      </div>
      <div class="cp-target cp-alert" id="not-sent" role="alert">
        <p>{f.errors.failed}</p>
        {email && <a class="link-line" href={mailto}>{f.fallback}<Arrow dir="ne" /></a>}
      </div>

      <form
        class="cp-form"
        method="post"
        action="/api/contact"
        novalidate
        data-contact-form
        data-email={email}
        data-subject={f.emailSubject}
        data-sent={f.sentText}
        data-sending={f.sending}
        data-msgs={JSON.stringify(f.errors)}
        data-labels={JSON.stringify({ name: f.name, email: f.email, roles: f.roles, message: f.message, link: f.link })}
      >
        <h2 class="cp-label eyebrow" id="cp-form-title">{f.kicker}</h2>

        <div class="cp-field">
          <div class="cp-field__head">
            <label class="eyebrow" for={fields.name}><span class="cp-no">01</span>{f.name}</label>
          </div>
          <input
            class="cp-input"
            id={fields.name}
            name="name"
            type="text"
            autocomplete="name"
            maxlength="100"
            required
            aria-describedby={`${fields.name}-err`}
          />
          <p class="cp-err" id={`${fields.name}-err`} data-err-for="name"></p>
        </div>

        <div class="cp-field">
          <div class="cp-field__head">
            <label class="eyebrow" for={fields.email}><span class="cp-no">02</span>{f.email}</label>
            <span class="cp-hint" id={`${fields.email}-hint`}>{f.emailHint}</span>
          </div>
          <input
            class="cp-input"
            id={fields.email}
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            maxlength="254"
            required
            aria-describedby={`${fields.email}-hint ${fields.email}-err`}
          />
          <p class="cp-err" id={`${fields.email}-err`} data-err-for="email"></p>
        </div>

        <fieldset class="cp-field cp-roles">
          <legend class="cp-field__head">
            <span class="eyebrow"><span class="cp-no">03</span>{f.roles}</span>
            <span class="cp-hint">{f.rolesHint}</span>
          </legend>
          <div class="cp-chips">
            {
              f.roleOptions.map((r) => (
                <label class="cp-chip">
                  <input type="checkbox" name="roles" value={r} />
                  <span>{r}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <div class="cp-field">
          <div class="cp-field__head">
            <label class="eyebrow" for={fields.message}><span class="cp-no">04</span>{f.message}</label>
          </div>
          <textarea
            class="cp-input cp-textarea"
            id={fields.message}
            name="message"
            rows="5"
            maxlength="4000"
            required
            placeholder={f.messageHint}
            aria-describedby={`${fields.message}-err`}></textarea>
          <p class="cp-err" id={`${fields.message}-err`} data-err-for="message"></p>
        </div>

        <div class="cp-field">
          <div class="cp-field__head">
            <label class="eyebrow" for={fields.link}><span class="cp-no">05</span>{f.link}</label>
            <span class="cp-hint" id={`${fields.link}-hint`}>{f.linkHint}</span>
          </div>
          <input
            class="cp-input"
            id={fields.link}
            name="link"
            type="url"
            inputmode="url"
            autocomplete="url"
            autocapitalize="off"
            spellcheck="false"
            maxlength="300"
            placeholder="https://"
            aria-describedby={`${fields.link}-hint ${fields.link}-err`}
          />
          <p class="cp-err" id={`${fields.link}-err`} data-err-for="link"></p>
        </div>

        <!-- Left empty by people; bots fill it in. (A name browsers never autofill.) -->
        <div class="cp-trap" aria-hidden="true">
          <label for="cf-hp">Leave this empty</label>
          <input id="cf-hp" name="hp" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="t" value="" data-contact-t />

        <div class="cp-alert" role="alert" hidden data-contact-alert>
          <p data-contact-alert-text></p>
          {
            email && (
              <a class="link-line" href={mailto} data-contact-fallback>
                {f.fallback}
                <Arrow dir="ne" />
              </a>
            )
          }
        </div>

        <div class="cp-submit">
          <button class="btn-solid cp-submit__btn" type="submit" data-contact-submit>
            <span data-contact-submit-label>{f.submit}</span>
            <Arrow dir="e" />
          </button>
          <p class="cp-note">{f.note}</p>
        </div>
      </form>

      <div class="cp-sent" hidden tabindex="-1" data-contact-sent>
        <p class="cp-sent__title display">{f.sentTitle}</p>
        <p class="cp-sent__text" data-contact-sent-text></p>
        <button class="link-line" type="button" data-contact-again>
          {f.another}
          <Arrow dir="e" />
        </button>
      </div>
    </section>
  </div>

  <footer class="cp-foot container">
    <p class="eyebrow">© {year} {site.name}</p>
    <p class="eyebrow">{c.footer}</p>
  </footer>
</div>

<script>
  import '../scripts/contact.ts';
</script>

<style>
  .cp {
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    grid-template-rows: auto 1fr auto;
    background: var(--bg);
  }

  /* ── Top line ── */
  .cp-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--header-h);
    padding-top: env(safe-area-inset-top);
  }
  .cp-wordmark {
    font-family: var(--font-display);
    font-size: 1.3125rem;
    font-weight: 440;
    letter-spacing: -0.025em;
    line-height: 1;
    padding-block: 0.4rem;
    white-space: nowrap;
    color: var(--ink);
  }
  .cp-top__status {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* ── Two columns ── */
  .cp-main {
    display: grid;
    gap: clamp(3.5rem, 2rem + 6vw, 5rem);
    align-content: start;
    padding-block: clamp(2.5rem, 1rem + 6vh, 6rem) clamp(4rem, 2rem + 8vh, 7rem);
  }
  @media (min-width: 1024px) {
    .cp-main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 33rem);
      column-gap: clamp(4rem, 8vw, 9rem);
      align-items: start;
    }
    .cp-intro {
      position: sticky;
      top: clamp(2rem, 6vh, 4rem);
    }
  }

  /* ── Left: who and what ── */
  .cp-kicker {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    color: var(--ink-2);
  }
  .cp-kicker::before {
    content: '';
    width: 1.75rem;
    height: 1px;
    background: var(--accent);
  }
  .cp-title {
    margin-top: 1.5rem;
    font-size: clamp(2.75rem, 1rem + 5.6vw, 6.75rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
    white-space: nowrap;
    color: var(--ink);
  }
  .cp-title__mark {
    color: var(--accent);
    font-style: italic;
    font-weight: var(--w-display-em);
  }
  .cp-lead {
    margin-top: 1.75rem;
    max-width: 30ch;
    font-size: clamp(1.0625rem, 0.98rem + 0.35vw, 1.25rem);
    line-height: 1.55;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .cp-label {
    color: var(--ink-3);
  }

  .cp-direct {
    margin-top: clamp(2.75rem, 1.5rem + 5vh, 4.5rem);
    max-width: 30rem;
  }
  .cp-direct__list {
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .cp-direct__row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    align-items: center;
    min-height: 3.5rem;
    border-bottom: 1px solid var(--line);
  }
  .cp-direct__row dt {
    color: var(--ink-3);
  }
  .cp-direct__row dd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
  }
  .cp-direct__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    min-width: 0;
    font-size: 1rem;
    color: var(--ink);
    overflow-wrap: anywhere;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 0% 1px;
    background-position: 0 calc(100% - 10px);
    background-repeat: no-repeat;
    transition: background-size 400ms var(--ease);
  }
  .cp-direct__link:hover,
  .cp-direct__link:focus-visible {
    background-size: 100% 1px;
  }
  .cp-copy {
    flex: none;
    min-height: 44px;
    padding: 0 0.25rem 0 1rem;
    color: var(--ink-3);
    cursor: pointer;
    transition: color var(--t-fast) var(--ease);
  }
  .cp-copy:hover,
  .cp-copy:focus-visible {
    color: var(--ink);
  }
  .cp-copy.is-done {
    color: var(--accent);
  }

  /* ── Right: the form ── */
  .cp-panel {
    position: relative;
    scroll-margin-top: 1.5rem;
  }
  .cp-form,
  .cp-sent,
  .cp-target {
    border-top: 1px solid var(--line-2);
    padding-top: 1.25rem;
  }
  .cp-form .cp-label {
    margin-bottom: 0.25rem;
  }
  .cp-field {
    margin-top: 2rem;
    border: 0;
    padding: 0;
    min-width: 0;
  }
  .cp-field__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0;
  }
  .cp-field__head .eyebrow {
    color: var(--ink-2);
  }
  .cp-no {
    margin-right: 0.9em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .cp-hint {
    font-size: var(--text-xs);
    color: var(--ink-3);
    text-align: right;
  }
  .cp-input {
    display: block;
    width: 100%;
    margin-top: 0.35rem;
    padding: 0.8rem 0 0.7rem;
    border: 0;
    border-bottom: 1px solid var(--line-2);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    /* 16px+ so phones don't zoom in */
    font-size: 1.0625rem;
    line-height: 1.4;
    caret-color: var(--accent);
    transition:
      border-color var(--t) var(--ease),
      box-shadow var(--t) var(--ease);
  }
  .cp-input::placeholder {
    color: var(--ink-faint);
    opacity: 1;
  }
  .cp-input:hover {
    border-bottom-color: rgb(233 233 230 / 0.32);
  }
  .cp-input:focus {
    outline: none;
    border-bottom-color: var(--ink);
    box-shadow: 0 1px 0 0 var(--ink);
  }
  .cp-input[aria-invalid='true'] {
    border-bottom-color: var(--accent);
    box-shadow: 0 1px 0 0 var(--accent);
  }
  .cp-textarea {
    min-height: 8.5rem;
    resize: vertical;
    line-height: 1.55;
  }
  .cp-err {
    min-height: 0;
    margin-top: 0.5rem;
    font-size: var(--text-sm);
    color: #ef5a76; /* the accent, lifted for small text on black */
  }
  .cp-err:empty {
    display: none;
  }

  .cp-roles legend {
    float: left; /* lets the legend sit in the flow like the other labels */
  }
  .cp-chips {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.9rem;
  }
  .cp-chip {
    position: relative;
    display: inline-flex;
    cursor: pointer;
  }
  .cp-chip input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .cp-chip span {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 40px;
    padding: 0 1rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-size: var(--text-sm);
    color: var(--ink-2);
    transition:
      box-shadow var(--t) var(--ease),
      color var(--t) var(--ease),
      background-color var(--t) var(--ease);
  }
  .cp-chip span::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ink-faint);
    transition: background-color var(--t) var(--ease);
  }
  .cp-chip:hover span {
    color: var(--ink);
    box-shadow: inset 0 0 0 1px rgb(233 233 230 / 0.32);
  }
  .cp-chip input:checked + span {
    color: var(--ink);
    background: rgb(233 233 230 / 0.06);
    box-shadow: inset 0 0 0 1px var(--ink);
  }
  .cp-chip input:checked + span::before {
    background: var(--accent);
  }
  .cp-chip input:focus-visible + span {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .cp-trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .cp-submit {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .cp-submit__btn {
    justify-content: space-between;
    min-width: 10.5rem;
    cursor: pointer;
  }
  .cp-submit__btn[aria-busy='true'] {
    opacity: 0.6;
    cursor: progress;
  }
  .cp-note {
    flex: 1 1 14rem;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-3);
  }

  .cp-alert {
    margin-top: 2rem;
    padding: 0.9rem 1rem 0.6rem;
    border-left: 2px solid var(--accent);
    background: rgb(213 27 69 / 0.06);
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
  .cp-alert .link-line {
    margin-top: 0.25rem;
  }

  .cp-sent:focus {
    outline: none;
  }
  .cp-sent__title {
    font-size: clamp(2.5rem, 1.6rem + 2.5vw, 3.5rem);
    color: var(--ink);
  }
  .cp-sent__title::after {
    content: '';
    display: inline-block;
    width: 0.16em;
    height: 0.16em;
    margin-left: 0.08em;
    border-radius: 50%;
    background: var(--accent);
  }
  .cp-sent__text {
    margin-top: 1rem;
    max-width: 36ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .cp-sent .link-line {
    margin-top: 1.75rem;
  }

  /* No-JavaScript results (#sent / #not-sent) */
  .cp-target {
    display: none;
    margin-bottom: 2rem;
  }
  .cp-target:target {
    display: block;
  }
  .cp-target.cp-alert {
    border-top: 0;
  }

  /* ── Bottom line ── */
  .cp-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.25rem;
    padding-bottom: max(1.25rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
  }
  .cp-foot .eyebrow {
    color: var(--ink-3);
  }
  @media (min-width: 1024px) {
    .cp-foot {
      border-top: 0;
      background-image: linear-gradient(var(--line), var(--line));
      background-size: calc(100% - 2 * var(--gutter)) 1px;
      background-position: center top;
      background-repeat: no-repeat;
    }
  }

  /* Phones */
  @media (max-width: 640px) {
    .cp-top__status span:last-child {
      font-size: 0.625rem;
      letter-spacing: 0.16em;
    }
    .cp-direct__row {
      grid-template-columns: 3.5rem minmax(0, 1fr);
    }
    .cp-submit__btn {
      width: 100%;
    }
  }

  /* Arrives once, quietly */
  @media (prefers-reduced-motion: no-preference) {
    .cp-rise {
      animation: cp-rise 900ms var(--ease) both;
      animation-delay: var(--d, 0ms);
    }
  }
  @keyframes cp-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
